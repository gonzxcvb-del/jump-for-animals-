local function scanLocations()
    local eggs = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and (obj.Name:lower():find("egg") or obj.Name:lower():find("яйц")) then
            local part = obj.PrimaryPart or obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChildWhichIsA("BasePart")
            if part and part.Position.Magnitude > 5 then
                table.insert(eggs, part)
            end
        end
    end

    serverLocations = {}
    if #eggs > 0 then
        table.sort(eggs, function(a, b) return a.Position.Y < b.Position.Y end)
        
        local group = {eggs[1]}
        for i = 2, #eggs do
            if math.abs(eggs[i].Position.Y - eggs[i-1].Position.Y) < 35 then
                table.insert(group, eggs[i])
            else
                table.insert(serverLocations, {Name = "🎯 Сектор (Высота " .. math.floor(group[1].Position.Y) .. ")", Eggs = group})
                group = {eggs[i]}
            end
        end
        table.insert(serverLocations, {Name = "🎯 Сектор (Высота " .. math.floor(group[1].Position.Y) .. ")", Eggs = group})
    else
        serverLocations = {{Name = "⚠️ Яйца не найдены", Eggs = {}}}
    end
    currentLocIndex = 1
    TierLabel.Text = serverLocations[currentLocIndex].Name
end

scanLocations()

LeftTierBtn.MouseButton1Click:Connect(function()
    if #serverLocations == 0 then return end
    currentLocIndex = currentLocIndex - 1
    if currentLocIndex < 1 then currentLocIndex = #serverLocations end
    TierLabel.Text = serverLocations[currentLocIndex].Name
end)

RightTierBtn.MouseButton1Click:Connect(function()
