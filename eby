local function stealBestEggInSelectedZone()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local returnPos = autoBasePosition or root.CFrame
    local loc = serverLocations[currentLocIndex]
    
    if not loc or not loc.Eggs or #loc.Eggs == 0 then
        scanLocations()
        loc = serverLocations[currentLocIndex]
    end

    if loc and loc.Eggs and #loc.Eggs > 0 then
        local bestEggPart = nil
        local maxScore = -1

        for _, part in ipairs(loc.Eggs) do
            if part and part.Parent then
                local score = 0
                local model = part.Parent
                
                for _, desc in ipairs(model:GetDescendants()) do
                    if desc:IsA("TextLabel") then
                        local txt = desc.Text:upper()
                        local numVal = 0
                        if txt:find("B") then
                            numVal = (tonumber(txt:match("[%d%.]+")) or 1) * 1000000000
                        elseif txt:find("M") then
                            numVal = (tonumber(txt:match("[%d%.]+")) or 1) * 1000000
                        elseif txt:find("K") then
                            numVal = (tonumber(txt:match("[%d%.]+")) or 1) * 1000
                        else
                            numVal = tonumber(txt:match("[%d%.]+")) or 1
                        end
                        score = score + numVal
                    end
                end

                if score == 0 then
                    score = part.Position.Magnitude
                end

                if score > maxScore then
                    maxScore = score
                    bestEggPart = part
                end
            end
        end

        if bestEggPart then
            root.CFrame = bestEggPart.CFrame + Vector3.new(0, 1, 0)
            root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)

            local start = tick()
            repeat
                task.wait(0.02)
                pcall(function()
                    firetouchinterest(bestEggPart, root, 0)
                    firetouchinterest(bestEggPart, root, 1)
                end)
                root.CFrame = bestEggPart.CFrame + Vector3.new(0, 1, 0)
            until (not bestEggPart or not bestEggPart.Parent) or (tick() - start > 1.3)

            root.CFrame = returnPos
        end
    end
end

